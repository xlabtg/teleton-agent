FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages/sdk/package.json packages/sdk/
COPY web/package.json web/

RUN npm ci

COPY . .

ENV NODE_ENV=test

CMD ["npm", "test"]
